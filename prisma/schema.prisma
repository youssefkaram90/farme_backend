generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  name     String  @unique
  password String
  role     String
  lastName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  permissions   UserPermission[]
}

/// Available permissions in the system (e.g. "sowing.view", "sowing.create")
model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserPermission[]
}

/// Many-to-many relation between User and Permission
model UserPermission {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, permissionId])
}

model RefreshToken {
  id String @id @default(uuid())

  /// User who owns this session
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// JWT ID (changes every rotation)
  jti String @unique

  /// Session identifier (stays the same during rotation)
  familyId String

  /// Hashed refresh token
  hashedToken String

  /// Optional session metadata
  deviceId   String?
  deviceName String?
  userAgent  String?
  ipAddress  String?

  /// Session state
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Delivery {
  id String @id @default(uuid())

  deliveryDate DateTime
  deliveryCode String
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lots DeliveryLot[]
}

model DeliveryLot {
  id                   String   @id @default(uuid())
  deliveryId           String
  delivery             Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  productName          String
  stockType            String // 'BIO' | 'CVT'
  productType          String // 'SEEDS' | 'PEAT'
  lotNumber            String
  quantity             Int
  thousandSeedsPerGram Float?
  supplierName         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deliveryId])
}

model StockItem {
  id              String @id @default(uuid())
  productType     String // 'SEEDS' | 'PEAT'
  stockType       String // 'BIO' | 'CVT'
  lotNumber       String
  productName     String
  supplierName    String
  currentQuantity Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@unique([productType, stockType, lotNumber])
}

model StockMovement {
  id          String    @id @default(uuid())
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  quantity      Float // positive = in, negative = out
  referenceType String // 'delivery', 'sowing'
  referenceId   String?

  createdAt DateTime @default(now())

  @@index([stockItemId])
  @@index([referenceType, referenceId])
}

// ============================================================
// TUNNELS & SECTORS (physical locations for sowing)
// ============================================================

model Tunnel {
  id       String  @id @default(uuid())
  number   String  @unique
  location String?
  capacity Int

  ssmSowings              SowingSSM[]
  sowingTunnelAssignments SowingTunnelAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sector {
  id       String  @id @default(uuid())
  name     String
  location String?

  lpmSowings        SowingLPM[]
  sowingPlanEntries SowingPlanEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([location, name])
}

// ============================================================
// SOWING PLANS (imported from client Excel)
// ============================================================

model SowingPlan {
  id       String  @id @default(uuid())
  planType String // 'SSM' | 'LPM'
  name     String  @unique
  location String?
  status   String  @default("DRAFT") // 'DRAFT' | 'IN_PROGRESS' | 'COMPLETED'

  entries    SowingPlanEntry[]
  ssmSowings SowingSSM[]
  lpmSowings SowingLPM[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SowingPlanEntry {
  id     String     @id @default(uuid())
  planId String
  plan   SowingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  variety   String
  stockType String // 'BIO' | 'CVT'
  peat      String? // SSM only: peat/trail details, e.g. "50% CVT 50% BIO"
  status    String  @default("PLANNED") // 'PLANNED' | 'EXECUTED'

  plannedDate DateTime

  // --- SSM fields ---
  plannedTrays Int?

  // --- LPM fields ---
  plannedQuantity Int?
  sectorId        String?
  sector          Sector? @relation(fields: [sectorId], references: [id])
  lines           String?
  metersPerLine   Float?
  seedsPerMeter   Int?

  // --- Execution progress ---
  executedTrays    Int? @default(0)
  executedQuantity Int? @default(0)

  // --- Link to executed sowings (1:N — multiple executions per entry) ---
  ssmSowings SowingSSM[]
  lpmSowings SowingLPM[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
}

// ============================================================
// SOWING SSM — Tunnel / Tray-based sowing
// ============================================================

model SowingSSM {
  id          String           @id @default(uuid())
  planId      String
  plan        SowingPlan       @relation(fields: [planId], references: [id])
  planEntryId String?
  planEntry   SowingPlanEntry? @relation(fields: [planEntryId], references: [id])

  variety     String
  sowingDate  DateTime
  lotNumber   String
  stockType   String // 'BIO' | 'CVT'
  productType String // 'SEEDS' | 'PEAT'

  numberOfTrays Int
  seedsPerTray  Int @default(285)
  quantityUsed  Int // numberOfTrays × seedsPerTray

  tunnelId     String?
  tunnelNumber String? // denormalized: "T1", "T2" — for UI display
  tunnel       Tunnel? @relation(fields: [tunnelId], references: [id])

  remarks String?

  plantStock PlantStock?

  tunnelAssignments SowingTunnelAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tunnelId])
  @@index([planId])
}

// ============================================================
// SOWING LPM — Field / Sector-based sowing
// ============================================================

model SowingLPM {
  id          String           @id @default(uuid())
  planId      String
  plan        SowingPlan       @relation(fields: [planId], references: [id])
  planEntryId String?
  planEntry   SowingPlanEntry? @relation(fields: [planEntryId], references: [id])

  variety     String
  sowingDate  DateTime
  lotNumber   String
  stockType   String // 'BIO' | 'CVT'
  productType String // 'SEEDS' | 'PEAT'

  quantityUsed Int

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id])

  lines         String?
  metersPerLine Float?
  seedsPerMeter Int?

  remarks String?

  plantStock PlantStock?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectorId])
  @@index([planId])
}

// ============================================================
// PLANT STOCK — Plants created after sowing
// ============================================================

model PlantStock {
  id          String     @id @default(uuid())
  ssmSowingId String?    @unique
  ssmSowing   SowingSSM? @relation(fields: [ssmSowingId], references: [id], onDelete: Cascade)
  lpmSowingId String?    @unique
  lpmSowing   SowingLPM? @relation(fields: [lpmSowingId], references: [id], onDelete: Cascade)

  variety   String
  location  String // tunnel number for SSM, sector name for LPM
  lotNumber String
  stockType String // 'CVT' | 'BIO'

  // SSM
  numberOfTrays Int?
  seedsPerTray  Int?
  // LPM
  lines         String?
  metersPerLine Float?
  seedsPerMeter Int?

  expectedPlants Int

  seedsSown Int @default(0) // actual seeds sown (= quantityUsed at creation)

  currentStage String @default("SEEDLING")

  counts PlantCount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location])
  @@index([variety])
}

// ============================================================
// PLANT COUNT — Sample-based counting (trays for SSM, meters for LPM)
// ============================================================

model PlantCount {
  id           String     @id @default(uuid())
  plantStockId String
  plantStock   PlantStock @relation(fields: [plantStockId], references: [id], onDelete: Cascade)

  countType       String // 'TRAY' | 'METER'
  sampleSize      Float // trays or meters sampled
  countedPlants   Int // plants counted in the sample
  density         Float // plants per tray / per meter (computed)
  estimatedPlants Int // extrapolated to the whole batch (computed)
  germinationRate Float? // estimatedPlants / seedsSown * 100 (computed)

  countDate DateTime @default(now())
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plantStockId])
}

// ============================================================
// TUNNEL ASSIGNMENTS — Many-to-many trays → tunnels
// ============================================================

model SowingTunnelAssignment {
  id          String    @id @default(uuid())
  ssmSowingId String
  ssmSowing   SowingSSM @relation(fields: [ssmSowingId], references: [id], onDelete: Cascade)
  tunnelId    String
  tunnel      Tunnel    @relation(fields: [tunnelId], references: [id], onDelete: Cascade)

  numberOfTrays Int // how many trays from this sowing go to this tunnel
  transportDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ssmSowingId, tunnelId])
  @@index([ssmSowingId])
  @@index([tunnelId])
}
